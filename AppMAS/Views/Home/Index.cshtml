@{
    ViewData["Title"] = "Trang chủ";
}


<div class="container mb-4">
    <div id="azureCarousel" class="carousel slide" data-bs-ride="carousel">

        <div class="carousel-inner">

      
            <div class="carousel-item active">
                <img src="~/images/MS1.avif"
                     class="d-block w-100"
                     alt="Microsoft Azure">

                <div class="carousel-caption">
                    <h1>Microsoft Azure</h1>
                    <p>Learn how Microsoft Azure cloud platform allows you to build, deploy, and scale web apps.</p>
                    <button class="btn btn-light">Learn More</button>
                </div>
            </div>

            
            <div class="carousel-item">
                <img src="~/images/MS2.avif"
                     class="d-block w-100"
                     alt="Microsoft IQ">

                <div class="carousel-caption">
                    <h1>Microsoft IQ</h1>
                    <p>Learn how Microsoft IQ cloud platform allows you to build, deploy, and scale web apps.</p>
                    <button class="btn btn-light">Learn More</button>
                </div>
            </div>

            
            <div class="carousel-item">
                <img src="~/images/MS3.avif"
                     class="d-block w-100"
                     alt="Microsoft AI">

                <div class="carousel-caption">
                    <h1>Microsoft AI</h1>
                    <p>Learn how Microsoft AI cloud platform allows you to build, deploy, and scale web apps.</p>
                    <button class="btn btn-light">Learn More</button>
                </div>
            </div>

        </div>

        
        <button class="carousel-control-prev" type="button"
                data-bs-target="#azureCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>

     
        <button class="carousel-control-next" type="button"
                data-bs-target="#azureCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>

    </div>
</div>

<div class="container">
    <h3 class="mb-3">Danh sách sản phẩm</h3>

    <div class="row">
        <div class="col-md-3">
            <div class="card mb-3">
                <img src="~/images/product1.webp" class="product-image" alt="Product 1">
                <div class="card-body text-center">
                    <p class="card-text">Product Name 1</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card mb-3">
                <img src="~/images/product2.webp" class="product-image" alt="Product 2">
                <div class="card-body text-center">
                    <p class="card-text">Product Name 2</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card mb-3">
                <img src="~/images/product3.webp" class="product-image" alt="Product 3">
                <div class="card-body text-center">
                    <p class="card-text">Product Name 3</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card mb-3">
                <img src="~/images/product4.webp" class="product-image" alt="Product 4">
                <div class="card-body text-center">
                    <p class="card-text">Product Name 4</p>
                </div>
            </div>
        </div>
    </div>
</div>