@model AppMAS.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container mt-4">

    <h2>Chi tiết sản phẩm</h2>

    <div class="row mt-4">

        <!-- Ảnh sản phẩm -->
        <div class="col-md-4">
            <img src="@Model.Image"
                 class="img-fluid"
                 alt="@Model.Name">
        </div>

        <!-- Thông tin sản phẩm -->
        <div class="col-md-8">

            <h3>Sản phẩm: @Model.Name</h3>

            <p>
                <strong>Giá gốc:</strong>
                <del>@Model.Price.ToString("N0") đ</del>
            </p>

            <p>
                <strong>Giá mới:</strong>
                @Model.SalePrice.ToString("N0") đ
            </p>

            <p>
                <strong>Mô tả:</strong>
                @Model.Description
            </p>

            <p>
                <strong>Trạng thái:</strong>
                @Model.Status
            </p>

            <p>
                <strong>Ngày đăng:</strong>
                @Model.CreatedAt
            </p>

            <a asp-controller="Product"
               asp-action="Index"
               class="btn btn-danger">
                Về danh sách
            </a>

        </div>

    </div>

</div>